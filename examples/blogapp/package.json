    "jose": "6.2.13"
  },
  "devDependencies": {
    "@foldkit/devtools": "0.169.0",
    "@foldkit/vite-plugin": "0.28.0",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
