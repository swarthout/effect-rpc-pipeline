{
  "name": "effect-rpc-pipeline",
  "version": "0.1.0",
  "description": "Effect-native RPC promise pipelining and batch execution",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" },
    "./Pipeline": { "types": "./dist/Pipeline.d.mts", "import": "./dist/Pipeline.mjs" },
    "./PipelineClient": { "types": "./dist/PipelineClient.d.mts", "import": "./dist/PipelineClient.mjs" },
    "./PipelineServer": { "types": "./dist/PipelineServer.d.mts", "import": "./dist/PipelineServer.mjs" },
    "./Capability": { "types": "./dist/Capability.d.mts", "import": "./dist/Capability.mjs" }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": { "effect": ">=4.0.0-rc.112 <5" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "capnweb": "0.12.0",
    "effect": "4.0.0-rc.112",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
