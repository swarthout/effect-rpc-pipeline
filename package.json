{
  "name": "effect-rpc-pipeline",
  "version": "0.1.0",
  "description": "Effect-native RPC promise pipelining and batch execution",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Pipeline": {
      "types": "./dist/Pipeline.d.ts",
      "import": "./dist/Pipeline.js"
    },
    "./PipelineClient": {
      "types": "./dist/PipelineClient.d.ts",
      "import": "./dist/PipelineClient.js"
    },
    "./PipelineServer": {
      "types": "./dist/PipelineServer.d.ts",
      "import": "./dist/PipelineServer.js"
    },
    "./Capability": {
      "types": "./dist/Capability.d.ts",
      "import": "./dist/Capability.js"
    },
    "./Duplex": {
      "types": "./dist/Duplex.d.ts",
      "import": "./dist/Duplex.js"
    },
    "./Auth": {
      "types": "./dist/Auth.d.ts",
      "import": "./dist/Auth.js"
    },
    "./RequestBatching": {
      "types": "./dist/RequestBatching.d.ts",
      "import": "./dist/RequestBatching.js"
    },
    "./Sql": {
      "types": "./dist/Sql.d.ts",
      "import": "./dist/Sql.js"
    },
    "./Telemetry": {
      "types": "./dist/Telemetry.d.ts",
      "import": "./dist/Telemetry.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "docs:generate": "node scripts/generate-api.mjs",
    "docs:check": "tsc -p tsconfig.docs.json && node scripts/generate-api.mjs --check && node scripts/check-links.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run docs:check",
    "examples:install": "npm ci --prefix examples/todoapp && npm ci --prefix examples/blogapp",
    "examples:check": "npm run typecheck --prefix examples/todoapp && npm test --prefix examples/todoapp && npm run typecheck --prefix examples/blogapp && npm test --prefix examples/blogapp && npm run build --prefix examples/blogapp",
    "prepack": "npm run build && npm run docs:check"
  },
  "peerDependencies": {
    "effect": "~4.0.6"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@types/node": "26.6.5",
    "capnweb": "0.12.0",
    "effect": "4.0.6",
    "jose": "6.2.13",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "tsx": "4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarthout/effect-rpc-pipeline.git"
  },
  "homepage": "https://github.com/swarthout/effect-rpc-pipeline#readme",
  "bugs": {
    "url": "https://github.com/swarthout/effect-rpc-pipeline/issues"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "keywords": [
    "effect",
    "rpc",
    "pipelining",
    "batching",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
