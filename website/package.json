{
  "name": "effect-rpc-pipeline-website",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node --import tsx scripts/content.ts",
    "predev": "npm run content",
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "npm run content && tsc --noEmit",
    "test": "vitest run",
    "build": "npm run content && vite build && vite build --ssr src/entry.server.ts --outDir dist-server && node --import tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "check": "npm run typecheck && npm test && npm run build && node --import tsx scripts/check-build.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.6",
    "@foldkit/markdown": "0.14.4",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "effect": "4.0.6",
    "foldkit": "0.169.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.28.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "effect": "$effect",
    "@effect/platform-browser": "$@effect/platform-browser"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
